    .filter-btn:hover {
        color: #334155;
        background: rgba(226, 232, 240, 0.5);
    }
    .filter-btn.active {
        color: #4f46e5;
        background: rgba(79, 70, 229, 0.08);
        border-color: rgba(79, 70, 229, 0.2);
    }

    /* Contact Cards */
    .contact-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        border-radius: 16px !important;
