@if (!string.IsNullOrEmpty(Model.StatusToast))
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1085;">
        <div id="statusToast" class="toast border-0 shadow-lg bg-glass-card" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
            <div class="toast-body p-3 d-flex align-items-center">
                @if (Model.StatusToastType == "success")
                {
                    <div class="toast-icon bg-success-gradient text-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-lg" viewBox="0 0 16 16">
                            <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 1.047-1.096l2.553 2.45L12.016 3.97a.733.733 0 0 1 .72-.03z"/>
                        </svg>
                    </div>
                }
                else if (Model.StatusToastType == "warning")
                {
                    <div class="toast-icon bg-warning-gradient text-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                            <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/>
                        </svg>
                    </div>
                }
                else
                {
                    <div class="toast-icon bg-danger-gradient text-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
                        </svg>
                    </div>
                }
                <div class="flex-grow-1">
                    <span class="text-dark small fw-semibold">@Model.StatusToast</span>
                </div>
                <button type="button" class="btn-close ms-2" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

