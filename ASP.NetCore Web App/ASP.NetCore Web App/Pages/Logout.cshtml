@page
@model ASP.NetCore_Web_App.Pages.LogoutModel
@{
    ViewData["Title"] = "Signing Out";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <div class="spinner-border text-danger" style="width: 4rem; height: 4rem;" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <h3 class="mb-3">Signing You Out</h3>
                    <p class="text-muted mb-0">Please wait while we securely end your session...</p>
                </div>
            </div>
        </div>
    </div>
</div>
