@page
@model ASP.NetCore_Web_App.Pages.SignedOutModel
@{
    ViewData["Title"] = "Signed Out";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg text-center p-5 bg-glass-card animate-fade-in">
                <div class="card-body p-0">
                    <div class="mb-4 text-success">
                        <div class="signed-out-icon bg-success bg-opacity-10 rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-shield-check" viewBox="0 0 16 16">
                                <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.118a1 1 0 0 0 .101.025 1 1 0 0 0 .1-.025q.114-.034.294-.118c.24-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                                <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                            </svg>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-2 text-dark">Signed Out</h3>
                    <p class="text-muted small mb-4">Your local application session has ended securely.</p>
                    
                    <div class="d-grid gap-3">
                        <!-- Sign In again locally -->
                        <a asp-page="/Login" class="btn btn-primary py-2.5 shadow-sm d-flex align-items-center justify-content-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-box-arrow-in-right me-2" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2a1.5 1.5 0 0 0 1.5 1.5h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z"/>
                                <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                            </svg>
                            Sign In Again
                        </a>
                        
                        <div class="divider d-flex align-items-center justify-content-center my-1">
                            <span class="text-muted small uppercase text-center bg-white px-2 px-md-3 z-index-2">Or Switch Accounts</span>
                        </div>

                        <!-- Central sign out -->
                        <a asp-page="/Logout" asp-page-handler="Central" class="btn btn-outline-danger py-2 d-flex align-items-center justify-content-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-globe me-2" viewBox="0 0 16 16">
                                <path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m7.5-6.923c-.67.204-1.335.82-1.887 1.855-.143.268-.276.56-.395.872.705.157 1.472.257 2.282.287zM8.75 1.077v2.787c.81-.03 1.577-.13 2.282-.287a9 9 0 0 0-.396-.872c-.552-1.036-1.218-1.65-1.886-1.855M9.75 1.5c.71.3 1.348.897 1.83 1.674l-.478.41a9 9 0 0 0-.47-.41c-.28-.24-.607-.464-.882-.674zm-3.5 0c-.275.21-.602.434-.882.674a9 9 0 0 0-.47.41l-.478-.41A7 7 0 0 1 6.25 1.5M4.887 4.792a9 9 0 0 0-.395.872C3.2 6.3 2.5 7.1 2 8c.5-.9 1.2-1.7 2.887-3.208M3.056 6.5a9 9 0 0 0-.47.41l-.478-.41c.28-.24.607-.464.882-.674zm9.888 0c.275.21.602.434.882.674l-.478.41a9 9 0 0 0-.47-.41c-.28-.24-.607-.464-.882-.674zm-4.764 8.423c.67-.204 1.335-.82 1.887-1.855.143-.268.276-.56.395-.872-.705-.157-1.472-.257-2.282-.287zm-1 0v-2.787c-.81.03-1.577.13-2.282.287.12.312.252.604.396.872.552 1.036 1.218 1.65 1.886 1.855M6.25 14.5c-.71-.3-1.348-.897-1.83-1.674l.478-.41c.154.133.312.27.47.41.28.24.607.464.882.674zm3.5 0c.275-.21.602-.434.882-.674.158-.14.316-.277.47-.41l.478.41a7 7 0 0 1-1.83 1.674M11.113 11.208c.552-1.036 1.218-1.65 1.887-1.855a9 9 0 0 1-.396.872c-.12.312-.252.604-.396.872-.552-1.036-1.218-1.65-1.886-1.855M4.887 11.208c-.67-.204-1.335-.82-1.887-1.855a9 9 0 0 0 .395.872c.12.312.252.604.396.872.552 1.036 1.218 1.65 1.886 1.855M8.75 8.713v2.787c.81-.03 1.577-.13 2.282-.287.12-.312.252-.604.396-.872a9 9 0 0 0-.396-.872c-.705.157-1.472.257-2.282.287m-1.5 0c-.81-.03-1.577-.13-2.282-.287a9 9 0 0 0 .396.872c.12.312.252.604.396.872v-2.787c-.81.03-1.577.13-2.282.287M15 8a7 7 0 1 1-16 0 7 7 0 0 1 16 0"/>
                            </svg>
                            Log Out of IdentityHub Centrally
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= STYLES ================= -->
<style>
    .bg-glass-card {
        background: rgba(255, 255, 255, 0.9) !important;
        backdrop-filter: blur(12px) !important;
        -webkit-backdrop-filter: blur(12px) !important;
        border: 1px solid rgba(220, 224, 230, 0.45) !important;
        border-radius: 20px !important;
    }

    .divider {
        position: relative;
    }
    .divider::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 50%;
        border-bottom: 1px solid rgba(220, 224, 230, 0.6);
        z-index: 1;
    }
    .divider span {
        z-index: 2;
    }

    .uppercase {
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .animate-fade-in {
        animation: fadeInUp 0.4s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
